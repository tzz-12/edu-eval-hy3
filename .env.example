# ===== Hy3 接入配置（复制本文件为 .env 并填入真实值；.env 已被 .gitignore 忽略）=====
# 所有密钥仅通过环境变量传入，代码不读取、不存储、不硬编码任何 Key。

# Hy3 OpenAI 兼容端点（必填，须带 /v1）
HY3_BASE_URL=

# Hy3 API Key（必填，切勿提交进仓库）
HY3_API_KEY=

# 模型名（按你的端点支持填写；Hy3 官方端点用 hy3）
HY3_MODEL=hy3

# 单次响应最大 token。Hy3 为快慢思考融合架构，推理档位较高时思维链会占用输出预算，
# 给太小会导致 JSON 被截断。
HY3_MAX_TOKENS=16384

# 单次请求超时（秒）
HY3_TIMEOUT=300

# 演示模式：设为 1 时返回占位结果，不连接 Hy3（用于本地试用/自动化测试）
HY3_MOCK=0
