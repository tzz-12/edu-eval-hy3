{"id": "as-07-001", "topic": "分式", "tier": 2, "grade": "八年级上册", "assertion": "分式是形如 A/B 的式子，其中 A、B 为整式，B 中含有字母且 B ≠ 0。", "formula": "", "conditions": "", "common_errors": ["认为只要分母有字母就是分式，忽略 B≠0 的要求", "将分子含字母分母不含字母的式子误认为分式"], "verification": {"method": "llm_consensus", "status": "quarantined", "detail": "一致性复核否决：人教版分式定义只要求A、B为整式且B含字母，B≠0是有意义条件而非定义条件", "checked_at": "2026-09-02T09:33:40+00:00"}, "std_ref": "", "concepts": ["分式", "整式"], "source": "EduEval 自建断言集（Hy3 生成 + 确定性校验）", "license": "MIT", "version": "tier2-v1", "quarantined": false}
{"id": "as-07-002", "topic": "分式", "tier": 2, "grade": "八年级上册", "assertion": "分式 A/B 有意义的条件是分母 B ≠ 0。", "formula": "", "conditions": "", "common_errors": ["忽略分母不能为0，直接运算", "认为分子为0时分式无意义"], "verification": {"method": "llm_consensus", "status": "verified", "detail": "一致性复核通过：分式有意义当且仅当分母B≠0", "checked_at": "2026-09-02T09:33:40+00:00"}, "std_ref": "", "concepts": ["分式有意义", "分母"], "source": "EduEval 自建断言集（Hy3 生成 + 确定性校验）", "license": "MIT", "version": "tier2-v1", "quarantined": false}
{"id": "as-07-003", "topic": "分式", "tier": 2, "grade": "八年级上册", "assertion": "分式 A/B 的值为 0 的条件是分子 A = 0 且分母 B ≠ 0。", "formula": "", "conditions": "", "common_errors": ["只令分子为0，忘记检验分母不为0", "误以为分母为0时分式值为0"], "verification": {"method": "llm_consensus", "status": "verified", "detail": "一致性复核通过：分式值为0需分子A=0且分母B≠0", "checked_at": "2026-09-02T09:33:40+00:00"}, "std_ref": "", "concepts": ["分式值为零", "分子", "分母"], "source": "EduEval 自建断言集（Hy3 生成 + 确定性校验）", "license": "MIT", "version": "tier2-v1", "quarantined": false}
{"id": "as-07-004", "topic": "分式", "tier": 2, "grade": "八年级上册", "assertion": "分式的基本性质：分式的分子与分母同乘一个不等于0的整式 C，分式的值不变，即 A/B = (A*C)/(B*C)。", "formula": "A/B = (A*C)/(B*C)", "conditions": "C != 0", "common_errors": ["忽略 C≠0 的条件", "错误写成 A/B = (A+C)/(B+C)"], "verification": {"method": "sympy_identity", "status": "verified", "detail": "恒等式（符号验证）", "checked_at": "2026-09-02T09:33:40+00:00"}, "std_ref": "", "concepts": ["分式基本性质", "整式"], "source": "EduEval 自建断言集（Hy3 生成 + 确定性校验）", "license": "MIT", "version": "tier2-v1", "quarantined": false}
{"id": "as-07-005", "topic": "分式", "tier": 2, "grade": "八年级上册", "assertion": "分式的基本性质：分式的分子与分母同除以一个不等于0的整式 C，分式的值不变，即 A/B = (A/C)/(B/C)。", "formula": "A/B = (A/C)/(B/C)", "conditions": "C != 0", "common_errors": ["忽略 C≠0", "错误写成 A/B = (A-C)/(B-C)"], "verification": {"method": "sympy_identity", "status": "verified", "detail": "恒等式（符号验证）", "checked_at": "2026-09-02T09:33:40+00:00"}, "std_ref": "", "concepts": ["分式基本性质", "约分"], "source": "EduEval 自建断言集（Hy3 生成 + 确定性校验）", "license": "MIT", "version": "tier2-v1", "quarantined": false}
{"id": "as-07-006", "topic": "分式", "tier": 2, "grade": "八年级上册", "assertion": "分式乘法法则是分子相乘作分子，分母相乘作分母，即 (a/b)*(c/d) = (a*c)/(b*d)。", "formula": "(a/b)*(c/d) = (a*c)/(b*d)", "conditions": "b != 0 and d != 0", "common_errors": ["分子分母交叉相乘", "忽略分母不为0的条件"], "verification": {"method": "sympy_identity", "status": "verified", "detail": "恒等式（符号验证）", "checked_at": "2026-09-02T09:33:40+00:00"}, "std_ref": "", "concepts": ["分式乘法", "整式"], "source": "EduEval 自建断言集（Hy3 生成 + 确定性校验）", "license": "MIT", "version": "tier2-v1", "quarantined": false}
{"id": "as-07-007", "topic": "分式", "tier": 2, "grade": "八年级上册", "assertion": "分式除法法则是除以一个分式等于乘这个分式的倒数，即 (a/b)/(c/d) = (a*d)/(b*c)。", "formula": "(a/b)/(c/d) = (a*d)/(b*c)", "conditions": "b != 0 and d != 0 and c != 0", "common_errors": ["错误地写成 (a/b)/(c/d) = (a*c)/(b*d)", "忽略除数分式不为0"], "verification": {"method": "sympy_identity", "status": "verified", "detail": "恒等式（符号验证）", "checked_at": "2026-09-02T09:33:40+00:00"}, "std_ref": "", "concepts": ["分式除法", "倒数"], "source": "EduEval 自建断言集（Hy3 生成 + 确定性校验）", "license": "MIT", "version": "tier2-v1", "quarantined": false}
{"id": "as-07-008", "topic": "分式", "tier": 2, "grade": "八年级上册", "assertion": "同分母分式相加减，分母不变，分子相加减，即 a/b + c/b = (a+c)/b。", "formula": "a/b + c/b = (a+c)/b", "conditions": "b != 0", "common_errors": ["分母也相加减", "符号错误如 a/b - c/b 写成 (a+c)/b"], "verification": {"method": "sympy_identity", "status": "verified", "detail": "恒等式（符号验证）", "checked_at": "2026-09-02T09:33:40+00:00"}, "std_ref": "", "concepts": ["分式加减", "同分母"], "source": "EduEval 自建断言集（Hy3 生成 + 确定性校验）", "license": "MIT", "version": "tier2-v1", "quarantined": false}
{"id": "as-07-009", "topic": "分式", "tier": 2, "grade": "八年级上册", "assertion": "异分母分式相加减，先通分化为同分母，即 a/b + c/d = (a*d + c*b)/(b*d)。", "formula": "a/b + c/d = (a*d + c*b)/(b*d)", "conditions": "b != 0 and d != 0", "common_errors": ["直接分子加分子分母加分母", "通分时漏乘"], "verification": {"method": "sympy_identity", "status": "verified", "detail": "恒等式（符号验证）", "checked_at": "2026-09-02T09:33:40+00:00"}, "std_ref": "", "concepts": ["分式加减", "通分"], "source": "EduEval 自建断言集（Hy3 生成 + 确定性校验）", "license": "MIT", "version": "tier2-v1", "quarantined": false}
{"id": "as-07-010", "topic": "分式", "tier": 2, "grade": "八年级上册", "assertion": "任何不等于0的数的0次幂等于1，即 a**0 = 1。", "formula": "a**0 = 1", "conditions": "a != 0", "common_errors": ["认为 a**0 = 0", "忽略 a≠0 条件导致 0**0 无意义"], "verification": {"method": "sympy_identity", "status": "verified", "detail": "恒等式（符号验证）", "checked_at": "2026-09-02T09:33:40+00:00"}, "std_ref": "", "concepts": ["零指数幂", "整数指数幂"], "source": "EduEval 自建断言集（Hy3 生成 + 确定性校验）", "license": "MIT", "version": "tier2-v1", "quarantined": false}
{"id": "as-07-011", "topic": "分式", "tier": 2, "grade": "八年级上册", "assertion": "任何不等于0的数的负整数次幂等于正整数次幂的倒数，即 a**(-n) = 1/(a**n)。", "formula": "a**(-n) = 1/(a**n)", "conditions": "a != 0", "common_errors": ["误以为 a**(-n) = -a**n", "忽略 a≠0"], "verification": {"method": "sympy_identity", "status": "verified", "detail": "恒等式（符号验证）", "checked_at": "2026-09-02T09:33:40+00:00"}, "std_ref": "", "concepts": ["负指数幂", "整数指数幂"], "source": "EduEval 自建断言集（Hy3 生成 + 确定性校验）", "license": "MIT", "version": "tier2-v1", "quarantined": false}
{"id": "as-07-012", "topic": "分式", "tier": 2, "grade": "八年级上册", "assertion": "分式方程 1/(x-1) = 2/(x+1) 的解为 x = 3。", "formula": "1/(x-1) - 2/(x+1) = 0", "conditions": "x != 1 and x != -1", "common_errors": ["去分母时漏乘", "解得 x=3 但未检验分母", "计算错误得 x=1 增根"], "verification": {"method": "sympy_solve", "status": "verified", "detail": "解集一致：[3]", "checked_at": "2026-09-02T09:33:40+00:00"}, "std_ref": "", "concepts": ["分式方程", "增根检验"], "source": "EduEval 自建断言集（Hy3 生成 + 确定性校验）", "license": "MIT", "version": "tier2-v1", "quarantined": false}
